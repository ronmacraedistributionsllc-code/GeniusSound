# Genius Sound — local development environment
# Copy to .env and adjust. NEVER commit real secrets.

# PostgreSQL connection
DATABASE_URL="postgresql://geniussound:geniussound@localhost:5432/geniussound?schema=public"

# Session signing / auth
AUTH_SECRET="change-me-to-a-long-random-string"

# Local object storage root (S3-compatible adapter swaps in via STORAGE_DRIVER)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./.data/storage"

# Optional: S3-compatible storage (MinIO, R2, etc.)
S3_ENDPOINT=""
S3_BUCKET="geniussound"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# AI generation providers (leave empty to run without generation — the app
# reports honest "provider not configured" errors instead of fake results)
# Local ComfyUI: http://127.0.0.1:8188 — see docs/LOCAL_COMFYUI.md
COMFYUI_URL=""
# Absolute path to api/workflows/wan22_ti2v_5b_i2v.json; optionally COMFYUI_WORKFLOW_ID_T2V for the text-only one
COMFYUI_WORKFLOW_ID=""
COMFYUI_WORKFLOW_ID_T2V=""
REPLICATE_API_TOKEN=""
FAL_KEY=""
OPENAI_API_KEY=""

# Transcription (word-level timestamps). Empty = manual lyrics only.
TRANSCRIPTION_PROVIDER=""

# Worker
WORKER_CONCURRENCY="2"
WORKER_POLL_MS="2000"

# Media/AI service (api/)
API_URL="http://localhost:8876"
API_INTERNAL_TOKEN=""          # set in any shared/hosted environment
REPLICATE_MODEL_VERSION=""
FAL_MODEL_ID=""

# Creative director LLM (any OpenAI-compatible endpoint; local example: Ollama)
LLM_BASE_URL=""                # e.g. http://localhost:11434/v1
LLM_API_KEY=""
LLM_MODEL=""                   # e.g. qwen2.5:14b-instruct
# Transcription model size for faster-whisper (tiny/base/small/medium/large-v3)
WHISPER_MODEL="small"
